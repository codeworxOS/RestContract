<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(DotNetTargetFrameworks)</TargetFrameworks>
		<LangVersion>Latest</LangVersion>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dotnet-restcontract</ToolCommandName>
		<!-- Microsoft.Build.Locator's MSBL001 check forbids shipping NuGet.Frameworks, expecting the SDK's
         copy to be used. We must ship it: the .NET 10 SDK carries NuGet.Frameworks 7.x, which drops the
         public NuGetFrameworkFullComparer constructor that our pinned NuGet.Protocol 6.3.3 calls, so
         binding to the SDK copy throws MethodAccessException. Microsoft.Build* stay runtime-excluded. -->
		<DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommandLineParser" />
		<PackageReference Include="Microsoft.Build.Framework" />
		<PackageReference Include="Microsoft.NET.StringTools" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeworx.Rest.Formatters.Newtonsoft\Codeworx.Rest.Formatters.Newtonsoft.csproj" />
		<ProjectReference Include="..\Codeworx.Rest.Primitives\Codeworx.Rest.Primitives.csproj" />
	</ItemGroup>
</Project>